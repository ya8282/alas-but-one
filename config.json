{
  "settings": {
    "maxOccurrences": 1,

    "MONGODB_URI": "mongodb://localhost:27017",
    "ignore_list": {
      "database": "alas_data",
      "collection": "ignore_words"
    },

    "ai": {
      "enabled": false,
      "model": "claude-haiku-4-5-20251001",
      "review_confidence_min": 0.3,
      "review_confidence_max": 0.7,
      "batch_size": 20,
      "send_context": true
    },

    "training": {
      "model_path": "models/classifier.pkl",
      "min_training_samples": 20
    }
  },

  "repositories": {
    "golang": {
      "name": "Golang Driver Docs",
      "text_format": "rst",
      "path": "~/dev/docs-golang",
      "source_dir": "source"
    }
  }
}
